# OS / IDE
.DS_Store
.vscode/
.idea/

# Symfony
/backend/app/var/
/backend/app/vendor/
/backend/app/.env.local
/backend/app/.env.*.local
/backend/app/.env.dev
/backend/app/.env.prod
/backend/app/.env.prod.local

# Logs / cache
*.log

# JWT keys (secret!)
/backend/app/config/jwt/*.pem

# Frontend (Vite/Vue)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Optional: logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Docker
**/.dockerignore

# DB dumps
*.sql
*.dump

# Composer artifacts (оставляем composer.lock, но игнорируем phar если появится)
composer.phar

# Local secrets and dev overrides
.env
docker-compose.override.yml

/docs
DESIGN.md
CLAUDE.md
AGENTS.md
UX_IMPROVEMENTS.md
PROJECT_DEFENSE.md
.claude/

# Playwright MCP output dir (screenshots, console logs, traces, .png/.jpeg/.log).
# All Playwright MCP screenshots MUST be saved here — see CLAUDE.md
# (MCP servers / Post-push browser verification gate sections).
# Never commit screenshots; they are dev artefacts only.
.playwright-mcp/
*.png
!frontend/**/*.png
!backend/**/*.png
!docs/**/*.png
