# Root Compose configuration. The README Quick Start copies this file without
# overwriting an existing .env, then appends a generated MERCURE_JWT_SECRET.
# That secret is required and shared by PHP, scheduler and Mercure.

NGINX_PORT=80
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure
CORS_ORIGINS='http://localhost http://localhost:5173'

# Local PostgreSQL settings. All three services receive the same values.
POSTGRES_DB=chat_local
POSTGRES_USER=chat_local
POSTGRES_PASSWORD='local-demo-only-change-me'
# Compose treats single-quoted values literally. Keep the quotes for passwords
# containing $, #, spaces or backslashes, and do not URL-encode raw values.
# DATABASE_URL is generated inside PHP/scheduler; do not set it here.

# Optional. Leave empty to run without the AI assistant.
ANTHROPIC_API_KEY=
