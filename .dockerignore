# Nginx only needs these build inputs. Everything else stays off the builder.
**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!docker/
!docker/nginx/
!docker/nginx/Dockerfile
!docker/nginx/default.conf
!VERSION

**/.env
**/.env.*
**/node_modules
**/dist
**/vendor
**/var
**/.git
**/.DS_Store
**/*.pem
**/*.key
**/*.log
**/*test*
**/*spec*
**/coverage
**/.cache
**/.vite
**/.playwright-mcp
**/.npmrc
**/.yarnrc*
**/.ssh
**/.codex
**/.claude
**/.idea
**/.vscode
**/*~
**/*.bak
**/*.swp
