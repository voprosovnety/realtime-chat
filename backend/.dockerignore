# Only checked-in runtime sources and container scripts belong in this context.
**
!Dockerfile
!docker-entrypoint.sh
!docker-test-entrypoint.sh
!database-url.php
!app/
!app/composer.json
!app/composer.lock
!app/symfony.lock
!app/.env
!app/importmap.php
!app/bin/
!app/bin/console
!app/bin/phpunit
!app/config/
!app/config/**
!app/src/
!app/src/**
!app/migrations/
!app/migrations/**
!app/templates/
!app/templates/**
!app/translations/
!app/translations/**
!app/assets/
!app/assets/**
!app/public/
!app/public/index.php

# Defense in depth inside the allowed directories.
**/.env.local
**/.env.*.local
**/.env.local.php
**/config/jwt
**/*.pem
**/*.key
**/.DS_Store
**/*.log
**/vendor
**/var
**/node_modules
**/.phpunit.cache
**/tests
**/coverage
**/.npmrc
**/.yarnrc*
**/.ssh
**/.codex
**/.claude
**/.idea
**/.vscode
**/*~
**/*.bak
**/*.swp
